# Copy to .env and fill in real values. Never commit .env.

NODE_ENV=development
PORT=4000
LOG_LEVEL=info

# MongoDB connection string (e.g. MongoDB Atlas)
MONGODB_URI=mongodb://localhost:27017/green_marketplace

# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=replace-with-a-long-random-secret-at-least-32-chars
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=7

BCRYPT_SALT_ROUNDS=12

# Comma-separated browser origins allowed by CORS. Leave empty for the mobile app only.
CORS_ORIGINS=

# Number of reverse proxies in front of the app (e.g. 1 behind a load balancer).
TRUST_PROXY=0

# Cloudinary image storage (required in production). Find these in the Cloudinary console.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=green-marketplace

# Optional, used only by `npm run seed:admin`. The password is prompted for if left empty.
SEED_ADMIN_NAME=
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
